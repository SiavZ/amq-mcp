@@ -3,6 +3,43 @@ use pretty_assertions::assert_eq;
 use ratatui::Terminal;
 use ratatui::backend::TestBackend;
 
+#[tokio::test]
+async fn amq_peer_input_is_literal_and_preserves_the_composer() {
+    let (mut chat, _rx, mut op_rx) = make_chatwidget_manual(None).await;
+    chat.thread_id = Some(ThreadId::new());
+    chat.bottom_pane
+        .set_composer_text("unfinished draft".into(), Vec::new(), Vec::new());
+    chat.queue_peer_message("!echo peer data".into());
+    assert_eq!(chat.bottom_pane.composer_text(), "unfinished draft");
+    match next_submit_op(&mut op_rx) {
+        Op::UserTurn { items, .. } => assert_eq!(
+            items,
+            vec![UserInput::Text {
+                text: "!echo peer data".to_string(),
+                text_elements: Vec::new(),
+            }]
+        ),
+        other => panic!("expected a literal user turn, got {other:?}"),
+    }
+}
+
+#[tokio::test]
+async fn amq_peer_input_waits_in_the_native_queue_while_busy() {
+    let (mut chat, _rx, mut op_rx) = make_chatwidget_manual(None).await;
+    chat.thread_id = Some(ThreadId::new());
+    chat.on_task_started();
+    chat.queue_peer_message("read peer message 1".into());
+    assert_eq!(
+        chat.queued_user_message_texts(),
+        vec!["read peer message 1".to_string()]
+    );
+    assert!(op_rx.try_recv().is_err());
+    assert_eq!(
+        chat.input_queue.queued_user_messages[0].source,
+        UserMessageSource::Peer
+    );
+}
