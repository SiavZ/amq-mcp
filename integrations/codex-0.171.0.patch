@@ -0,0 +1,103 @@
+//! Optional AMQ delivery over a private pipe, independent of terminal input.
+
+use std::process::Stdio;
+
+use serde::Deserialize;
+use tokio::io::AsyncBufReadExt;
+use tokio::io::BufReader;
+use tokio::process::Command;
+
+use crate::app_event::AppEvent;
+use crate::app_event_sender::AppEventSender;
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Frame {
+    #[serde(rename = "type")]
+    kind: String,
+    content: String,
+}
+
+fn parse_message(line: &str) -> Option<String> {
+    if line.len() > 256 * 1024 {
+        return None;
+    }
+    let frame: Frame = serde_json::from_str(line).ok()?;
+    (frame.kind == "amq_message" && !frame.content.trim().is_empty()).then_some(frame.content)
+}
+
+pub(crate) fn start(tx: AppEventSender) {
+    let Some(command) = std::env::var_os("AMQ_MCP_FEED") else {
+        return;
+    };
+    tokio::spawn(async move {
+        let mut child = match Command::new(command)
+            .stdin(Stdio::null())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::null())
+            .kill_on_drop(true)
+            .spawn()
+        {
+            Ok(child) => child,
+            Err(error) => {
+                tracing::warn!("AMQ feed failed to start: {error}");
+                tx.send(AppEvent::InsertHistoryCell(Box::new(
+                    crate::history_cell::new_warning_event(format!(
+                        "AMQ feed failed to start: {error}"
+                    )),
+                )));
+                return;
+            }
+        };
+        let Some(stdout) = child.stdout.take() else {
+            return;
+        };
+        let mut lines = BufReader::new(stdout).lines();
+        loop {
+            tokio::select! {
+                _ = tx.app_event_tx.closed() => break,
+                line = lines.next_line() => match line {
+                    Ok(Some(line)) => {
+                        if let Some(text) = parse_message(&line) {
+                            tx.send(AppEvent::AmqMessage(text));
+                        }
+                    }
+                    Ok(None) => {
+                        tracing::warn!("AMQ feed closed; unread mail remains in AMQ");
+                        tx.send(AppEvent::InsertHistoryCell(Box::new(crate::history_cell::new_warning_event(
+                            "AMQ feed stopped. Messages remain unread in AMQ.".to_string(),
+                        ))));
+                        break;
+                    }
+                    Err(error) => {
+                        tracing::warn!("AMQ feed read failed: {error}");
+                        break;
+                    }
+                }
+            }
+        }
+        let _ = child.kill().await;
+    });
+}
+
+#[cfg(test)]
+mod tests {
+    use super::parse_message;
+
+    #[test]
+    fn accepts_only_bounded_amq_frames() {
+        assert_eq!(
+            parse_message(r#"{"type":"amq_message","content":"Read message 1"}"#),
+            Some("Read message 1".to_string())
+        );
+        for invalid in [
+            "not json",
+            r#"{"type":"other","content":"hello"}"#,
+            r#"{"type":"amq_message","content":" "}"#,
+            r#"{"type":"amq_message","content":12}"#,
+        ] {
+            assert_eq!(parse_message(invalid), None);
+        }
+        assert_eq!(parse_message(&"a".repeat(256 * 1024 + 1)), None);
+    }
+}
