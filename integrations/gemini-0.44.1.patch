+/**
+ * @license
+ * Copyright 2026 Google LLC
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+import { describe, it, expect, vi, afterEach } from 'vitest';
+import { EventEmitter } from 'node:events';
+import { PassThrough } from 'node:stream';
+import { spawn } from 'node:child_process';
+import { parseAmqMessage, startAmqInbox } from './useAmqInbox.js';
+
+vi.mock('node:child_process', () => ({ spawn: vi.fn() }));
+vi.mock('@google/gemini-cli-core', () => ({
+  coreEvents: { emitFeedback: vi.fn() },
+  debugLogger: { warn: vi.fn() },
+}));
+
+afterEach(() => {
+  vi.unstubAllEnvs();
+  vi.clearAllMocks();
+});
+
+describe('AMQ terminal inbox', () => {
+  it('requires explicit opt-in', () => {
+    vi.stubEnv('AMQ_MCP_FEED', '');
+    startAmqInbox(vi.fn())();
+    expect(spawn).not.toHaveBeenCalled();
+  });
+
+  it('rejects malformed, empty, oversized, and unrelated frames', () => {
+    for (const invalid of [
+      'not json',
+      '{"type":"other","content":"hello"}',
+      '{"type":"amq_message","content":" "}',
+      '{"type":"amq_message","content":12}',
+      'a'.repeat(256 * 1024 + 1),
+    ])
+      expect(parseAmqMessage(invalid)).toBeUndefined();
+    expect(parseAmqMessage('{"type":"amq_message","content":"/quit"}')).toMatch(
+      /^AMQ peer notification/,
+    );
+  });
+
+  it('delivers framed notifications through the native message callback and stops its own feed', () => {
+    vi.stubEnv('AMQ_MCP_FEED', '/test/amq-feed');
+    const child = Object.assign(new EventEmitter(), {
+      stdout: new PassThrough(),
+      stderr: new PassThrough(),
+      kill: vi.fn(),
+    });
+    vi.mocked(spawn).mockReturnValue(
+      child as unknown as ReturnType<typeof spawn>,
+    );
+    const onMessage = vi.fn();
+    const close = startAmqInbox(onMessage);
+    child.stdout.write('{"type":"amq_message","content":"Read ID 1"}\n');
+    expect(onMessage).toHaveBeenCalledWith(
+      expect.stringContaining('Read ID 1'),
+    );
+    close();
+    child.emit('exit', 0);
+    child.stdout.write('{"type":"amq_message","content":"Read ID 2"}\n');
+    expect(onMessage).toHaveBeenCalledTimes(1);
+    expect(child.kill).toHaveBeenCalledWith('SIGTERM');
+  });
+});
